 "people": [
  {
   "id": "hanne",
   "name": "Hanne Brook",
   "title": "Farmhand of Ostwick",
   "hint": "a sunburnt young woman with a hayfork over her shoulder",
   "meet": "The young woman with the hayfork has been watching you work all week. “You’re not hopeless,” she says at last. “I’m Hanne. Come and have an ale when the light goes.”",
   "talk": [
    "Hanne tells you which cows kick, which fields flood and which of the Brook cousins owes her money.",
    "“One day I’ll have my own strip by the river,” Hanne says. “Barley. Nobody tells barley what to do.”"
   ],
